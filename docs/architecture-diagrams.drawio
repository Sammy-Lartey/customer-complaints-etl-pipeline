<mxfile host="Electron" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) draw.io/29.5.2 Chrome/142.0.7444.265 Electron/39.6.1 Safari/537.36" version="29.5.2" pages="3">
  <diagram name="Pipeline Architecture" id="pipeline-arch">
    <mxGraphModel dx="1051" dy="632" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="src" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;" value="Excel Workbook&#xa;(monthly sheets)" vertex="1">
          <mxGeometry height="60" width="200" x="320" y="20" as="geometry" />
        </mxCell>
        <mxCell id="ingest" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;align=left;spacingLeft=10;" value="1. INGEST&#xa;Excel → Bronze&#xa;&#xa;SHA-256 hash per sheet vs. ingestion log.&#xa;Only changed sheets are landed." vertex="1">
          <mxGeometry height="90" width="280" x="280" y="130" as="geometry" />
        </mxCell>
        <mxCell id="clean" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=left;spacingLeft=10;" value="2. CLEAN&#xa;Bronze → Silver&#xa;&#xa;Merge sheets, normalize columns, fuzzy-match&#xa;regions, format phones, validate turnaround time." vertex="1">
          <mxGeometry height="90" width="280" x="280" y="270" as="geometry" />
        </mxCell>
        <mxCell id="resolve" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;align=left;spacingLeft=10;" value="3. RESOLVE&#xa;Silver → Staging&#xa;&#xa;Split customers/complaints. Join public.client.&#xa;Resolve stable customerId via persistent crosswalk." vertex="1">
          <mxGeometry height="90" width="280" x="280" y="410" as="geometry" />
        </mxCell>
        <mxCell id="client" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;dashed=1;" value="public.client&#xa;(simulated upstream CRM,&#xa;not owned by this pipeline)" vertex="1">
          <mxGeometry height="60" width="200" x="620" y="425" as="geometry" />
        </mxCell>
        <mxCell id="load" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=10;" value="4. LOAD&#xa;Staging → Gold&#xa;&#xa;Upsert customers (stable ID).&#xa;Full-refresh complaints (no stable complaint key)." vertex="1">
          <mxGeometry height="90" width="280" x="280" y="550" as="geometry" />
        </mxCell>
        <mxCell id="analytics" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;align=left;spacingLeft=10;" value="5. ANALYTICS&#xa;(parallel)&#xa;&#xa;Indexes | Views | Materialized View Refresh" vertex="1">
          <mxGeometry height="80" width="280" x="280" y="690" as="geometry" />
        </mxCell>
        <mxCell id="bi" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d0e0e3;strokeColor=#666666;fontSize=12;align=left;spacingLeft=10;" value="6. BI&#xa;Metabase (read-only, gold schema only)" vertex="1">
          <mxGeometry height="60" width="280" x="280" y="820" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="src" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="ingest">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="clean">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" edge="1" parent="1" source="clean" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="resolve">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" edge="1" parent="1" source="resolve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;" target="client">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="resolve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="load">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" edge="1" parent="1" source="load" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="analytics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="analytics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" target="bi">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
