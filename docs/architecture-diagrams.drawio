  <diagram name="Pipeline Flow" id="pipeline-flow">
    <mxGraphModel dx="1400" dy="1600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="s1" value="1. Generate / receive source data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="20" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="2. Read Excel workbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="100" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="3. Process individual sheets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="180" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="4. Generate SHA-256 hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="260" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="5. Check ingestion history" style="rhombus;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="340" width="320" height="90" as="geometry" />
        </mxCell>
        <mxCell id="skip" value="Skip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="365" width="160" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s6" value="6. Write Bronze Parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="470" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s7" value="7. Clean and standardize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="550" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s8" value="8. Run data quality checks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="630" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s9" value="9. Process resolution data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="710" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s10" value="10. Write Silver Parquet" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="790" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s11" value="11. Map customer identities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="870" width="280" height="50" as="geometry" />
        </mxCell>
        <mxCell id="s12" value="12. Load Gold data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
