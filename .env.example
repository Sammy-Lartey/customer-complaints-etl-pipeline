# Airflow's Fernet key -- encrypts sensitive values in Airflow's own metadata DB
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=<your-airflow-fernet-key>

# Warehouse Postgres -- YOUR pipeline's data, separate from Airflow's metadata DB
WAREHOUSE_DB_USER=<your-warehouse-db-user>
WAREHOUSE_DB_PASSWORD=<your-warehouse-db-password>
WAREHOUSE_DB_NAME=<your-warehouse-db-name>

# Source Excel file
SOURCE_EXCEL_PATH=/opt/airflow/data/source/<your-source-file>.xlsx
EXCLUDE_SHEETS=<sheet-to-exclude>

METABASE_READER_PASSWORD=<your-metabase-reader-password>